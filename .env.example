# ── Hifazat environment ─────────────────────────────────────────────
# Copy to .env and fill in. Never commit the real .env.

# SQLAlchemy database URL.
# Dev (SQLite):         sqlite:///./hifazat.db
# Docker (PostgreSQL): postgresql+psycopg://hifazat:hifazat@db:5432/hifazat
DATABASE_URL=sqlite:///./hifazat.db

# JWT signing secret — MUST be a long random string in production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_in_production
JWT_ALGORITHM=HS256
# Token lifetime in minutes (default 1440 = 24 h)
JWT_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins (CORS).
FRONTEND_ORIGIN=http://127.0.0.1:8000

# Global API rate limit per client per minute.
RATE_LIMIT_PER_MINUTE=120

# Risk score at or above which a transaction raises an alert (0–100).
RISK_THRESHOLD=40

# This is normally False in deployed environments.
DEBUG=false
